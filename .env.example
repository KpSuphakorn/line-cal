# LINE Messaging API Configuration
APP_ENV=development
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LIFF_ID=your_liff_id
WEBAPP_BASE_URL=http://localhost:8000/webapp

# Google Gemini API Key (for Vision food calorie estimation)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# 1. Local SQLite: sqlite:///./line_cal.db
# 2. Supabase runtime (Direct or Session pooler on port 5432):
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Use the Direct connection string for Alembic when it is reachable:
# MIGRATION_DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./line_cal.db
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
AI_DAILY_LIMIT=30
