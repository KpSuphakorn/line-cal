# LINE Messaging API Configuration
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Gemini API Key (for Vision food calorie estimation)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# 1. Local SQLite: sqlite:///./line_cal.db
# 2. Supabase (PostgreSQL Recommended):
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./line_cal.db

# User Default Metrics (Tailored for Suphakorn)
USER_DEFAULT_GENDER=male
USER_DEFAULT_AGE=22
USER_DEFAULT_HEIGHT_CM=174.0
USER_DEFAULT_WEIGHT_KG=72.0
USER_DEFAULT_DAILY_TARGET_KCAL=1950.0
USER_DEFAULT_TARGET_PROTEIN_G=145.0
USER_DEFAULT_TARGET_CARBS_G=220.0
USER_DEFAULT_TARGET_FAT_G=55.0
